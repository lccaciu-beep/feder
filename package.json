{
  "name": "feder",
  "version": "0.1.0",
  "private": true,
  "description": "Feder – handschriftliche Notizen und PDF-Annotation als Offline-PWA für das iPad",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "vite build",
    "preview": "vite preview",
    "preview:lan": "vite build --mode lan && vite preview --mode lan",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "ci": "npm run check && npm run lint && npm run test && npm run build && npm run test:e2e",
    "postinstall": "node scripts/copy-pdfjs.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "perfect-freehand": "1.2.3",
    "svelte": "5.57.2",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
